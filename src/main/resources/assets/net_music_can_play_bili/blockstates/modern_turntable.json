{
  "multipart": [
    {
      "when": { "facing": "north", "has_disc": "false" },
      "apply": { "model": "net_music_can_play_bili:block/modern_turntable" }
    },
    {
      "when": { "facing": "east", "has_disc": "false" },
      "apply": { "model": "net_music_can_play_bili:block/modern_turntable", "y": 90 }
    },
    {
      "when": { "facing": "south", "has_disc": "false" },
      "apply": { "model": "net_music_can_play_bili:block/modern_turntable", "y": 180 }
    },
    {
      "when": { "facing": "west", "has_disc": "false" },
      "apply": { "model": "net_music_can_play_bili:block/modern_turntable", "y": 270 }
    },
    {
      "when": { "facing": "north", "has_disc": "true" },
      "apply": { "model": "net_music_can_play_bili:block/modern_turntable_playing" }
    },
    {
      "when": { "facing": "east", "has_disc": "true" },
      "apply": { "model": "net_music_can_play_bili:block/modern_turntable_playing", "y": 90 }
    },
    {
      "when": { "facing": "south", "has_disc": "true" },
      "apply": { "model": "net_music_can_play_bili:block/modern_turntable_playing", "y": 180 }
    },
    {
      "when": { "facing": "west", "has_disc": "true" },
      "apply": { "model": "net_music_can_play_bili:block/modern_turntable_playing", "y": 270 }
    }
  ]
}
